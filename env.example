# Server Configuration
PORT=8080

# SQLite Configuration
DB_PATH=yt_dashboard.db

# YouTube API OAuth Configuration
# Get these credentials from Google Cloud Console (https://console.cloud.google.com)
YT_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
YT_CLIENT_SECRET=your-client-secret-here
YT_REDIRECT_URI=http://localhost:8080/oauth2/callback
