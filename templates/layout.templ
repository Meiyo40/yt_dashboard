package templates

templ Layout(title string, activeTab string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dim">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - YT Comment Dashboard</title>
			
			<!-- Google Fonts: Inter -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
			
			<!-- DaisyUI CSS CDN -->
			<link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.10/dist/full.min.css" rel="stylesheet" type="text/css"/>
			
			<!-- Tailwind CSS Play CDN -->
			<script src="https://cdn.tailwindcss.com"></script>
			<script>
				tailwind.config = {
					theme: {
						extend: {
							fontFamily: {
								sans: ['Inter', 'sans-serif'],
							}
						}
					}
				}
			</script>
			
			<!-- HTMX -->
			<script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
			
			<!-- Alpine.js -->
			<script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
			
			<style>
				/* Add a subtle custom glassmorphism effect and scrollbar styling */
				.glass-panel {
					background: rgba(30, 41, 59, 0.7);
					backdrop-filter: blur(12px);
					border: 1px solid rgba(255, 255, 255, 0.05);
				}
				::-webkit-scrollbar {
					width: 6px;
					height: 6px;
				}
				::-webkit-scrollbar-track {
					background: transparent;
				}
				::-webkit-scrollbar-thumb {
					background: rgba(255, 255, 255, 0.1);
					border-radius: 4px;
				}
				::-webkit-scrollbar-thumb:hover {
					background: rgba(255, 255, 255, 0.2);
				}
			</style>
		</head>
		<body class="bg-base-300 text-base-content min-h-screen flex flex-col font-sans antialiased">
			<!-- Header Navbar -->
			<header class="navbar bg-base-100 border-b border-base-200 px-6 sticky top-0 z-50 shadow-md">
				<div class="flex-1 gap-2">
					<div class="avatar placeholder">
						<div class="bg-red-600 text-neutral-content rounded-lg w-8 h-8 flex items-center justify-center">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="white" class="w-5 h-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z" />
							</svg>
						</div>
					</div>
					<div>
						<h1 class="font-extrabold text-lg tracking-tight bg-gradient-to-r from-red-500 to-orange-400 bg-clip-text text-transparent">
							Meiyo Dashboard
						</h1>
						<p class="text-[10px] text-base-content/50 uppercase tracking-widest font-semibold">YT Comments & Replies</p>
					</div>
				</div>
				<div class="flex-none gap-4">
					<!-- Quota indicator stub -->
					<div class="hidden sm:flex flex-col items-end text-xs bg-base-200 px-3 py-1.5 rounded-lg border border-base-300">
						<span class="font-medium text-base-content/70">Quota Usage: <span class="text-primary font-bold">0 / 10,000</span></span>
						<div class="w-24 bg-base-300 h-1 rounded-full mt-1 overflow-hidden">
							<div class="bg-primary h-full" style="width: 0%"></div>
						</div>
					</div>

					<!-- OAuth Profile Preview Stub -->
					<div x-data="{ open: false }" class="relative">
						<button @click="open = !open" class="btn btn-ghost btn-circle avatar border border-base-200">
							<div class="w-9 rounded-full bg-neutral text-neutral-content flex items-center justify-center font-bold">
								U
							</div>
						</button>
						<ul x-show="open" @click.outside="open = false" class="menu menu-sm absolute right-0 mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52 border border-base-200" style="display: none;">
							<li><span class="text-xs font-semibold text-base-content/50">NOT CONNECTED</span></li>
							<li><a class="text-primary font-medium" href="/oauth2/login">Connect YouTube</a></li>
						</ul>
					</div>
				</div>
			</header>

			<!-- Dashboard Layout -->
			<div class="flex flex-1">
				<!-- Sidebar -->
				<aside class="w-64 bg-base-100 border-r border-base-200 p-4 hidden md:flex flex-col gap-6">
					<div>
						<span class="text-[10px] font-bold text-base-content/40 tracking-wider uppercase px-4">Navigation</span>
						<ul class="menu menu-md w-full gap-1 p-0 mt-2">
							<li>
								<a href="/" class={ "flex items-center gap-3 py-2 px-4 rounded-lg font-medium", templ.KV("active bg-primary text-primary-content", activeTab == "dashboard") }>
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
										<path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
									</svg>
									Dashboard
								</a>
							</li>
							<li>
								<a href="/comments" class={ "flex items-center gap-3 py-2 px-4 rounded-lg font-medium", templ.KV("active bg-primary text-primary-content", activeTab == "comments") }>
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
									</svg>
									Tracked Comments
									<span class="badge badge-sm badge-neutral ml-auto">0</span>
								</a>
							</li>
						</ul>
					</div>
					
					<div class="mt-auto">
						<div class="p-4 rounded-xl bg-base-200 border border-base-300 flex flex-col gap-2">
							<span class="text-xs font-bold uppercase tracking-wider text-base-content/40">Status</span>
							<div class="flex items-center gap-2">
								<span class="relative flex h-2.5 w-2.5">
									<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
									<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500"></span>
								</span>
								<span class="text-xs text-base-content/70 font-semibold">Disconnected</span>
							</div>
							<a href="/oauth2/login" class="btn btn-primary btn-sm btn-block mt-1">
								Log In YouTube
							</a>
						</div>
					</div>
				</aside>

				<!-- Main Content -->
				<main class="flex-1 p-6 md:p-8 overflow-y-auto max-w-7xl mx-auto w-full">
					{ children... }
				</main>
			</div>

			<!-- Footer -->
			<footer class="footer footer-center p-4 bg-base-100 text-base-content/50 border-t border-base-200 text-xs">
				<aside>
					<p>© 2026 YouTube Comment Dashboard - Built with Go, Templ, HTMX & Alpine.js</p>
				</aside>
			</footer>
		</body>
	</html>
}
