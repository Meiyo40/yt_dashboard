package pages

import "yt_dashboard/templates"

templ Index(commentsCount int, repliesCount int, quotaUsage int, isConnected bool) {
	@templates.Layout("Dashboard", "dashboard", isConnected, commentsCount) {
		<div class="space-y-8">
			<!-- Hero / Welcome Header -->
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
				<div>
					<h2 class="text-3xl font-extrabold tracking-tight">Dashboard Overview</h2>
					<p class="text-base-content/60 mt-1">Monitor replies and engage with your community in real-time.</p>
				</div>
				<div>
					if !isConnected {
						<a href="/oauth2/login" class="btn btn-primary shadow-lg shadow-primary/20 flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
							</svg>
							Connect YouTube Account
						</a>
					} else {
						<div class="badge badge-success gap-2 py-3 px-4 shadow-sm">
							<span class="w-2 h-2 rounded-full bg-emerald-100 animate-pulse"></span>
							YouTube Connected
						</div>
					}
				</div>
			</div>

			<!-- Stats Grid -->
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
				<!-- Tracked Comments Card -->
				<div class="stats shadow bg-base-100 border border-base-200">
					<div class="stat">
						<div class="stat-figure text-primary">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
								<path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
							</svg>
						</div>
						<div class="stat-title font-semibold text-base-content/50">Tracked Comments</div>
						<div class="stat-value text-primary mt-1 text-4xl font-extrabold">{ templ.JSONString(commentsCount) }</div>
						<div class="stat-desc mt-2">Active comments in registry</div>
					</div>
				</div>

				<!-- Unseen Replies Card -->
				<div class="stats shadow bg-base-100 border border-base-200">
					<div class="stat">
						<div class="stat-figure text-secondary">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
								<path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a9.04 9.04 0 0 1-1.801 1.3c-1.347.74-2.993.614-4.228-.242a9.034 9.034 0 0 1-2.437-2.717 18.275 18.275 0 0 0-2.583-2.898A9.033 9.033 0 0 1 2.25 9c0-2.83 1.916-5.209 4.583-5.918a9.04 9.04 0 0 1 10.334 0C19.834 3.791 21.75 6.17 21.75 9c0 1.25-.25 2.441-.703 3.528m-7.19 5.805a9.061 9.061 0 0 1-4.708 0M18.001 19c0 .015 0 .03-.002.045a3.25 3.25 0 0 1-6.496 0 3.376 3.376 0 0 1-.002-.045m6.5 0H11.5" />
							</svg>
						</div>
						<div class="stat-title font-semibold text-base-content/50">Unseen Replies</div>
						<div class="stat-value text-secondary mt-1 text-4xl font-extrabold">{ templ.JSONString(repliesCount) }</div>
						<div class="stat-desc mt-2">Awaiting your response</div>
					</div>
				</div>

				<!-- Quota Card -->
				<div class="stats shadow bg-base-100 border border-base-200">
					<div class="stat">
						<div class="stat-figure text-warning">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
							</svg>
						</div>
						<div class="stat-title font-semibold text-base-content/50">Daily API Quota</div>
						<div class="stat-value text-warning mt-1 text-4xl font-extrabold">{ templ.JSONString(quotaUsage) } <span class="text-xs font-semibold text-base-content/40">/ 10k</span></div>
						<div class="stat-desc mt-2">Resets daily at 0:00 PST</div>
					</div>
				</div>
			</div>

			<!-- Main Panel: Notifications Feed -->
			<div class="card bg-base-100 border border-base-200 shadow-xl overflow-hidden">
				<div class="px-6 py-5 border-b border-base-200 flex items-center justify-between">
					<h3 class="font-bold text-lg flex items-center gap-2">
						<span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
						Recent Notifications
					</h3>
					<div class="flex items-center gap-2">
						<button hx-get="/partials/feed" hx-target="#feed-container" hx-indicator="#feed-loading" class="btn btn-ghost btn-sm flex items-center gap-1.5 hover:bg-base-200">
							<svg id="feed-loading" class="animate-spin h-3.5 w-3.5 text-base-content hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
							Refresh
						</button>
					</div>
				</div>

				<div class="p-6">
					<!-- HTMX Feed Container -->
					<div id="feed-container" hx-get="/partials/feed" hx-trigger="load" class="min-h-[200px]">
						<!-- Loader placeholder -->
						<div class="flex flex-col items-center justify-center py-12 gap-3 text-base-content/40">
							<span class="loading loading-spinner loading-md"></span>
							<p class="text-sm font-medium">Loading notifications feed...</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
