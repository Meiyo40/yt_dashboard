package partials

import "yt_dashboard/db"

templ CommentList(comments []db.OwnComment, isConnected bool, errorMsg string) {
	<div id="comment-list">
		if errorMsg != "" {
			<div class="alert alert-error mb-4">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
				</svg>
				<span>{ errorMsg }</span>
			</div>
		}
		if len(comments) == 0 {
			<div class="flex flex-col items-center justify-center py-12 px-4 text-center">
				<div class="bg-base-200 p-4 rounded-full text-base-content/30 mb-4 border border-base-300">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
						<path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
					</svg>
				</div>
				<h4 class="text-lg font-bold tracking-tight text-base-content/80">No Tracked Comments</h4>
				<p class="text-sm text-base-content/50 max-w-sm mt-1">
					Use the form above to add a YouTube comment URL to start tracking replies.
				</p>
			</div>
		} else {
			<div class="overflow-x-auto">
				<table class="table table-zebra">
					<thead>
						<tr>
							<th>Video</th>
							<th>Your Comment</th>
							<th class="text-center">Replies</th>
							<th class="text-center">Last Checked</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, c := range comments {
							<tr>
								<td>
									<div class="flex flex-col">
										if c.VideoTitle != "" {
											<a href={ "https://www.youtube.com/watch?v=" + c.VideoID } target="_blank" class="font-medium text-sm link link-hover max-w-[180px] truncate">
												{ c.VideoTitle }
											</a>
										} else {
											<span class="text-sm text-base-content/50 max-w-[180px] truncate">
												{ c.VideoID }
											</span>
										}
										if c.ChannelTitle != "" {
											<span class="text-xs text-base-content/40">{ c.ChannelTitle }</span>
										}
									</div>
								</td>
								<td>
									<p class="text-sm max-w-[300px] line-clamp-2">{ c.TextOriginal }</p>
								</td>
								<td class="text-center">
									<span class={ "badge badge-sm", templ.KV("badge-ghost", c.ReplyCount == 0), templ.KV("badge-primary font-semibold", c.ReplyCount > 0) }>
										{ templ.JSONString(c.ReplyCount) }
									</span>
								</td>
								<td class="text-center">
									if c.LastCheckedAt != nil {
										<span class="text-xs text-base-content/50">{ c.LastCheckedAt.Format("Jan 02, 15:04") }</span>
									} else {
										<span class="text-xs text-base-content/30 italic">Never</span>
									}
								</td>
								<td class="text-right">
									<button hx-delete={ "/partials/comments/" + c.CommentID }
										hx-target="#comment-list"
										hx-swap="outerHTML"
										hx-confirm="Remove this comment from tracking?"
										class="btn btn-ghost btn-xs text-error">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
											<path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
										</svg>
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}
